<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- AUTH module -->
    <include file="db/changelog/changes/001-create-users-table.xml" relativeToChangelogFile="false"/>

    <!--
        Add one <include> line per new changeset file, in order, as each
        module is implemented. Naming convention: NNN-short-description.xml
        (e.g. 002-create-topics-table.xml for SYSTEM-02).
        Never edit a changeset that has already run in any shared/deployed
        database - add a new changeset instead, Liquibase tracks history
        by id+author+file and will error on checksum mismatch otherwise.
    -->

</databaseChangeLog>
