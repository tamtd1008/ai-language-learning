    <changeSet id="008-seed-conversation-messages" author="backend">
        <insert tableName="conversation_messages">
            <column name="session_id" valueComputed="(SELECT cs.id FROM conversation_sessions cs JOIN users u ON cs.user_id = u.id WHERE u.username = 'hannah_le')"/>
            <column name="role" value="USER"/>
            <column name="content" value="Hello! I'm planning a trip to Japan next month."/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP - INTERVAL '2 days'"/>
