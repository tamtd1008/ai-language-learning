<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Matches com.example.backend.entity.VocabularyProgress -->
    <changeSet id="010-create-vocabulary-progress-table" author="backend">
        <createTable tableName="vocabulary_progress">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_vocab_progress_user"
                             references="users(id)"/>
            </column>
            <column name="vocabulary_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_vocab_progress_vocabulary"
                             references="vocabulary(id)"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint tableName="vocabulary_progress"
                              columnNames="user_id, vocabulary_id"
                              constraintName="uk_vocab_progress_user_vocabulary"/>
    </changeSet>

</databaseChangeLog>
