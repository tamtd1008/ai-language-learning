<?xml version="1.0"?>
<sdf version="1.9">
  <world name="language_lab">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light name="sun" type="directional">
      <direction>-0.4 -0.3 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
    </light>
    <model name="language_robot">
      <link name="base">
        <inertial><mass>2</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <visual name="body">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.15 0.65 0.6 1</ambient><diffuse>0.15 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
      <joint name="mount" type="fixed"><parent>world</parent><child>base</child></joint>
      <link name="head">
        <pose>0 0 0.64 0 0 0</pose>
        <inertial><mass>0.25</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <visual name="shell">
          <geometry><sphere><radius>0.19</radius></sphere></geometry>
          <material><ambient>0.83 0.9 0.9 1</ambient><diffuse>0.83 0.9 0.9 1</diffuse></material>
        </visual>
        <visual name="face">
          <pose>0.167 0 0.035 0 0 0</pose>
          <geometry><box><size>0.055 0.23 0.12</size></box></geometry>
          <material><ambient>0.04 0.1 0.15 1</ambient><diffuse>0.04 0.1 0.15 1</diffuse></material>
        </visual>
      </link>
      <joint name="neck" type="revolute">
        <parent>base</parent><child>head</child>
        <pose relative_to="head">0 0 -0.14 0 0 0</pose>
        <axis><xyz>0 1 0</xyz><limit><lower>-0.4</lower><upper>0.5</upper></limit></axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>neck</joint_name>
        <topic>/language_robot/head</topic>
        <p_gain>5</p_gain>
        <d_gain>0.6</d_gain>
      </plugin>
    </model>
  </world>
</sdf>
