# Copy this file to .env and fill in real values.
# .env is already ignored by git - never commit real secrets.

# Used by docker-compose.yml to create the Postgres container
DB_NAME=ai_language_learning
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Used by the Spring Boot app (application.properties) to connect
DB_URL=jdbc:postgresql://localhost:5432/ai_language_learning

# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION=86400000

# Default admin account seeded on first startup (see AdminSeeder.java).
# Change the password before this ever runs anywhere but your own machine.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# AI provider: ollama (default, local, no key needed) | mock | gemini
AI_PROVIDER=ollama

# Ollama must be running locally: ollama serve + ollama pull qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Raise if local inference on your machine is slower than this
OLLAMA_TIMEOUT_SECONDS=120

# Only needed when AI_PROVIDER=gemini - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60

# Speech (STT/TTS): azure (needs key below) | mock (default, no key needed)
SPEECH_PROVIDER=mock

# Only needed when SPEECH_PROVIDER=azure - create a free-tier Speech
# resource at https://portal.azure.com and copy its key + region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_SPEECH_TIMEOUT_SECONDS=30
